# AI Provider
AI_PROVIDER=gemini

# Gemini Model
AI_MODEL=gemini-3.5-flash-lite

# Add your Gemini API key locally in .env
GEMINI_API_KEY=

# Web application security
# Keep APP_ENV=development for local use.
# For public deployment, set APP_ENV=production and use a long,
# unique password over HTTPS. Never commit the real .env file.
APP_ENV=development
APP_USERNAME=admin
APP_PASSWORD=

# Comma-separated hostnames. Set your actual domain in production.
ALLOWED_HOSTS=localhost,127.0.0.1

# Chat API rate limit. Use Redis for shared limits across multiple workers.
CHAT_RATE_LIMIT=10 per minute
RATELIMIT_STORAGE_URI=memory://
